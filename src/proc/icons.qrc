<!-- The log list's action icons, from TortoiseGit src/Resources/action*.ico (see icons/license.txt), recoloured from
     icons/original/ by scripts/recolour-icons.sh -->
<RCC version="1.0">
    <qresource prefix="/kortoisegit">
        <file>icons/actionadded-16.png</file>
        <file>icons/actionadded-20.png</file>
        <file>icons/actionadded-24.png</file>
        <file>icons/actionadded-32.png</file>
        <file>icons/actionadded-64.png</file>
        <file>icons/actionconflicted-16.png</file>
        <file>icons/actionconflicted-20.png</file>
        <file>icons/actionconflicted-24.png</file>
        <file>icons/actionconflicted-32.png</file>
        <file>icons/actionconflicted-64.png</file>
        <file>icons/actiondeleted-16.png</file>
        <file>icons/actiondeleted-20.png</file>
        <file>icons/actiondeleted-24.png</file>
        <file>icons/actiondeleted-32.png</file>
        <file>icons/actiondeleted-64.png</file>
        <file>icons/actionerror-16.png</file>
        <file>icons/actionerror-20.png</file>
        <file>icons/actionerror-24.png</file>
        <file>icons/actionerror-32.png</file>
        <file>icons/actionerror-64.png</file>
        <file>icons/actionfetching-16.png</file>
        <file>icons/actionfetching-20.png</file>
        <file>icons/actionfetching-24.png</file>
        <file>icons/actionfetching-32.png</file>
        <file>icons/actionfetching-64.png</file>
        <file>icons/actionmodified-16.png</file>
        <file>icons/actionmodified-20.png</file>
        <file>icons/actionmodified-24.png</file>
        <file>icons/actionmodified-32.png</file>
        <file>icons/actionmodified-64.png</file>
        <file>icons/actionreplaced-16.png</file>
        <file>icons/actionreplaced-20.png</file>
        <file>icons/actionreplaced-24.png</file>
        <file>icons/actionreplaced-32.png</file>
        <file>icons/actionreplaced-64.png</file>
        <!-- The app icon, for running from build/bin where the installed hicolor theme copy is missing -->
        <file alias="icons/kortoisegit-16.png">../../data/icons/16-apps-kortoisegit.png</file>
        <file alias="icons/kortoisegit-22.png">../../data/icons/22-apps-kortoisegit.png</file>
        <file alias="icons/kortoisegit-32.png">../../data/icons/32-apps-kortoisegit.png</file>
        <file alias="icons/kortoisegit-48.png">../../data/icons/48-apps-kortoisegit.png</file>
        <file alias="icons/kortoisegit-64.png">../../data/icons/64-apps-kortoisegit.png</file>
        <file alias="icons/kortoisegit-128.png">../../data/icons/128-apps-kortoisegit.png</file>
        <file alias="icons/kortoisegit-256.png">../../data/icons/256-apps-kortoisegit.png</file>
    </qresource>
</RCC>
